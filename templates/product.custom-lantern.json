        "custom_liquid_JGL6Kq": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .file-upload-row { display:flex; align-items:center; gap:10px; margin-bottom:10px; }\n  .file-name { font-style: italic; margin:0; }\n  .error-message { color:#d00; margin:6px 0 0; display:none; }\n  .product-form__input .form__label { margin-bottom: 6px; display:block; }\n  .file-upload-group { margin-bottom: 14px; }\n</style>\n\n<div class=\"product-form__input\">\n  <label class=\"form__label\">Upload images</label>\n\n  <!-- Image 1 (required via custom JS) -->\n  <div class=\"file-upload-group\">\n    <div class=\"file-upload-row\">\n      <input\n        id=\"file-upload-image-1\"\n        form=\"product-form-{{ section.id }}\"\n        name=\"properties[Image 1]\"\n        type=\"file\"\n        accept=\"image/*\"\n        style=\"display:none;\"\n      />\n      <button type=\"button\" id=\"button-upload-image-1\" class=\"button\">Upload Image 1</button>\n      <p id=\"fileName-upload-image-1\" class=\"file-name\">No file chosen</p>\n    </div>\n    <p id=\"error-image-1\" class=\"error-message\">Please upload Image 1.</p>\n  </div>\n\n  <!-- Image 2 (optional) -->\n  <div class=\"file-upload-group\">\n    <div class=\"file-upload-row\">\n      <input id=\"file-upload-image-2\" form=\"product-form-{{ section.id }}\" name=\"properties[Image 2]\" type=\"file\" accept=\"image/*\" style=\"display:none;\" />\n      <button type=\"button\" id=\"button-upload-image-2\" class=\"button\">Upload Image 2</button>\n      <p id=\"fileName-upload-image-2\" class=\"file-name\">No file chosen</p>\n    </div>\n  </div>\n\n  <!-- Image 3 (optional) -->\n  <div class=\"file-upload-group\">\n    <div class=\"file-upload-row\">\n      <input id=\"file-upload-image-3\" form=\"product-form-{{ section.id }}\" name=\"properties[Image 3]\" type=\"file\" accept=\"image/*\" style=\"display:none;\" />\n      <button type=\"button\" id=\"button-upload-image-3\" class=\"button\">Upload Image 3</button>\n      <p id=\"fileName-upload-image-3\" class=\"file-name\">No file chosen</p>\n    </div>\n  </div>\n</div>\n\n<script>\n  // Re-usable wiring for each upload row\n  function wireUpload(idSuffix, opts = {}) {\n    const input   = document.getElementById(`file-upload-${idSuffix}`);\n    const button  = document.getElementById(`button-upload-${idSuffix}`);\n    const fileP   = document.getElementById(`fileName-upload-${idSuffix}`);\n    const errorEl = document.getElementById(`error-${idSuffix}`) || null;\n\n    if (button) {\n      button.addEventListener('click', () => input && input.click());\n    }\n    if (input) {\n      input.addEventListener('change', (e) => {\n        const f = e.target.files && e.target.files[0];\n        if (fileP) fileP.textContent = f ? f.name : 'No file chosen';\n        if (errorEl) errorEl.style.display = 'none';\n      });\n    }\n    return { input, errorEl };\n  }\n\n  document.addEventListener('DOMContentLoaded', () => {\n    // Get the correct product form (ID or fallback to action)\n    const form =\n      document.getElementById('product-form-{{ section.id }}') ||\n      document.querySelector('form[action*=\"/cart/add\"]');\n\n    if (!form) return;\n\n    // Ensure proper encoding for file uploads\n    form.setAttribute('enctype', 'multipart/form-data');\n\n    // Shopify sometimes disables HTML5 validation\n    if (form.hasAttribute('novalidate')) form.removeAttribute('novalidate');\n\n    // Find the actual submit button inside THIS form\n    const submitBtn =\n      form.querySelector('[type=\"submit\"], .product-form__submit');\n\n    const u1 = wireUpload('image-1'); // required (custom)\n    const u2 = wireUpload('image-2');\n    const u3 = wireUpload('image-3');\n\n    // Validate on form submit (not button click) so it also catches Enter key, etc.\n    form.addEventListener('submit', (e) => {\n      const image1Missing = !(u1.input && u1.input.files && u1.input.files.length);\n      if (image1Missing) {\n        e.preventDefault();\n        const err = document.getElementById('error-image-1');\n        if (err) err.style.display = 'block';\n\n        // If the theme put the button into a \"loading/disabled\" state, clear it\n        if (submitBtn) {\n          submitBtn.removeAttribute('disabled');\n          submitBtn.classList.remove('loading', 'disabled', 'is-loading');\n        }\n\n        // Focus the upload button to guide the user\n        const btn1 = document.getElementById('button-upload-image-1');\n        if (btn1) btn1.focus();\n      }\n    });\n\n    // Optional: as soon as Image 1 is chosen, make sure submit is enabled\n    if (u1.input && submitBtn) {\n      u1.input.addEventListener('change', () => {\n        submitBtn.removeAttribute('disabled');\n        submitBtn.classList.remove('loading', 'disabled', 'is-loading');\n      });\n    }\n  });\n</script>"
          }
        },

{% style %}
{{ section.settings.font | font_face: font_display: 'swap' }}
{% assign medium_font = section.settings.font | font_modify: 'weight', '500' %}{{ medium_font | font_face: font_display: 'swap' }}
#PL-{{ section.id }} { --pl-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }}; }
{% endstyle %}

<div id="PL-{{ section.id }}" class="pl-about color-{{ section.settings.color_scheme }} gradient">
  <section class="pl-about-1">
    <div class="pl-about-2 page-width">
      <div class="pl-about-3">{{ section.settings.text_1 | escape }}</div>
      <p class="pl-about-4">{{ section.settings.text_2 | escape }}</p>
    </div>
  </section>
</div>

{% stylesheet %}
.pl-about {
  font-family: var(--pl-font);
  font-size: 16px;
  font-weight: 400;
  line-height: normal;
  letter-spacing: normal;
  color: rgb(var(--color-foreground));
  background: rgb(var(--color-background));
  -webkit-font-smoothing: antialiased;
}

.pl-about *,
.pl-about *::before,
.pl-about *::after {
  box-sizing: border-box;
}

.pl-about a {
  color: rgb(var(--color-link));
  text-decoration: none;
}

.pl-about a:hover {
  color: rgba(var(--color-link), 0.75);
}

.pl-about a:focus-visible,
.pl-about select:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 4px;
}

.pl-about select {
  font-family: inherit;
}

.pl-about h1,
.pl-about h2,
.pl-about h3 {
  color: inherit;
}

.pl-about [id] {
  scroll-margin-top: 110px;
}

.pl-about .pl-about-1 {
  background: rgb(var(--color-background));
  border-top: 1px solid rgba(var(--color-foreground), 0.15);
  border-bottom: 1px solid rgba(var(--color-foreground), 0.15);
  padding: 64px 0;
}

.pl-about .pl-about-2 {
  text-align: center;
}

.pl-about .pl-about-3 {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgb(var(--color-link));
}

.pl-about .pl-about-4 {
  font-family: var(--pl-font);
  font-size: 21px;
  line-height: 1.6;
  color: rgba(var(--color-foreground), 0.85);
  margin: 20px 0 0;
  text-wrap: pretty;
}

/* pl-mobile */
@media(max-width: 749px) {
  .pl-about .pl-about-1 {
    padding: 44px 0;
  }

  .pl-about .pl-about-4 {
    font-size: 18px;
    line-height: 1.55;
    margin-top: 14px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "PL About",
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "About us",
      "default": "About us"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Bo•Co Home makes decorative lanterns in Co…",
      "default": "Bo•Co Home makes decorative lanterns in Colorado, printing scenic photography onto four-panel LED lanterns that light a room the way a postcard lights a memory."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "assistant_n4"
    }
  ],
  "presets": [
    {
      "name": "PL About"
    }
  ]
}
{% endschema %}

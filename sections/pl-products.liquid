{% style %}

  {{ section.settings.font | font_face: font_display: 'swap' }}

  {% assign medium_font = section.settings.font | font_modify: 'weight', '500' %}
  {{ medium_font | font_face: font_display: 'swap' }}

  #PL-{{ section.id }} {
    --pl-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --pl-columns: {{ section.settings.columns }};



    --pl-padding-top: {{ section.settings.padding_top }}px;
    --pl-padding-bottom: {{ section.settings.padding_bottom }}px;

    --pl-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --pl-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  }

{% endstyle %}


<div id="PL-{{ section.id }}" class="pl-products color-{{ section.settings.color_scheme }} gradient">

  <section id="collection" class="pl-products-1">

    <div class="pl-products-2 page-width">

      {% assign selected_collection = section.settings.collection %}

      {% if section.settings.show_heading %}
        <div class="pl-products-heading">
          <div>
            {% if section.settings.eyebrow != blank %}
              <p class="pl-products-eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {% endif %}
            {% if section.settings.title != blank %}
              <h2 class="pl-products-title">{{ section.settings.title | escape }}</h2>
            {% endif %}
          </div>
          <p class="pl-products-summary">
            {{ section.settings.availability_text | escape }}{% if section.settings.show_count and selected_collection != blank %}{% if section.settings.availability_text != blank %} &middot; {% endif %}{{ selected_collection.products_count }} {{ section.settings.count_label | escape }}{% endif %}
          </p>
        </div>
      {% endif %}

      {% if selected_collection != blank %}

        {% for lantern in selected_collection.products %}

          <div class="pl-products-block">

            <article class="pl-products-3">

              <div class="pl-products-4">

                <a
                  href="{{ lantern.url }}"
                  aria-label="{{ lantern.title | escape }}"
                  class="pl-products-image-link"
                >

                  {% assign card_image = lantern.featured_image %}
                  {% assign hover_image = lantern.media[1].preview_image %}

                  <div class="pl-products-image{% if card_image != blank and hover_image != blank %} pl-products-image--has-hover{% endif %}">

                    {% if card_image != blank %}

                      {{
                        card_image
                        | image_url: width: 1200
                        | image_tag:
                          widths: '300, 450, 600, 900, 1200',
                          sizes: '(min-width: 990px) 33vw, 50vw',
                          loading: 'lazy',
                          alt: lantern.title,
                          class: 'pl-product-image-main'
                      }}

                      {% if hover_image != blank %}

                        {{
                          hover_image
                          | image_url: width: 1200
                          | image_tag:
                            widths: '300, 450, 600, 900, 1200',
                            sizes: '(min-width: 990px) 33vw, 50vw',
                            loading: 'lazy',
                            alt: lantern.title,
                            class: 'pl-product-image-hover'
                        }}

                      {% endif %}

                    {% else %}

                      {{ 'product-1' | placeholder_svg_tag: 'pl-products-placeholder' }}

                    {% endif %}

                  </div>

                </a>

              </div>


              <h3 class="pl-products-6">

                <a href="{{ lantern.url }}">
                  {{ lantern.title | escape }}
                </a>

              </h3>


              {% if lantern.vendor != blank %}

                <div class="pl-products-7">
                  {{ lantern.vendor | escape }}
                </div>

              {% endif %}


              {% if lantern.description != blank %}

                <div class="pl-products-8">
                  {{ lantern.description | strip_html | truncate: 160 }}
                </div>

              {% endif %}


              <div class="pl-products-9">

                {% assign frame_option = blank %}

                {% for option in lantern.options_with_values %}

                  {% assign option_name_downcase = option.name | downcase %}

                  {% if option_name_downcase contains 'frame'
                    or option_name_downcase == 'color'
                    or option_name_downcase == 'colour'
                  %}

                    {% assign frame_option = option %}
                    {% break %}

                  {% endif %}

                {% endfor %}


                {% if frame_option != blank %}

                  <label
                    for="Frame-{{ section.id }}-{{ lantern.id }}"
                    class="pl-products-10"
                  >
                    {{ frame_option.name | escape }}
                  </label>


                  <select
                    id="Frame-{{ section.id }}-{{ lantern.id }}"
                    name="frame"
                    class="pl-products-11"
                  >

                    {% for value in frame_option.values %}

                      <option value="{{ value | escape }}">
                        {{ value | escape }}
                      </option>

                    {% endfor %}

                  </select>

                {% endif %}


                <div class="pl-products-12">

                  <span class="pl-products-13">
                    {{ section.settings.gate_label | escape }}
                  </span>

                  {% if section.settings.link_1 != blank %}

                    <a
                      href="{{ section.settings.link_1 }}"
                      class="pl-products-14"
                    >
                      {{ section.settings.text_3 | escape }}
                    </a>

                  {% endif %}

                </div>

              </div>

            </article>

          </div>

        {% endfor %}

      {% else %}

        <div class="pl-products-empty">
          Please select a collection from the section settings.
        </div>

      {% endif %}

    </div>

  </section>

</div>


{% stylesheet %}

  .pl-products {
    font-family: var(--pl-font);
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    -webkit-font-smoothing: antialiased;
  }

  .pl-products *,
  .pl-products *::before,
  .pl-products *::after {
    box-sizing: border-box;
  }

  .pl-products a {
    color: rgb(var(--color-link));
    text-decoration: none;
  }

  .pl-products a:hover {
    color: rgba(var(--color-link), 0.75);
  }

  .pl-products a:focus-visible,
  .pl-products select:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .pl-products select {
    font-family: inherit;
  }

  .pl-products h1,
  .pl-products h2,
  .pl-products h3 {
    color: inherit;
  }

  .pl-products [id] {
    scroll-margin-top: 110px;
  }


  .pl-products .pl-products-1 {
    padding-top: var(--pl-padding-top);
    padding-bottom: var(--pl-padding-bottom);
  }


  .pl-products .pl-products-2 {
    display: grid;
    grid-template-columns:
      repeat(var(--pl-columns), minmax(0, 1fr));
    gap: 40px 32px;
  }


  .pl-products .pl-products-block {
    height: 100%;
    min-width: 0;
  }

  .pl-products .pl-products-heading {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px 32px;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.15);
    padding-bottom: 20px;
  }

  .pl-products .pl-products-eyebrow {
    margin: 0;
    color: rgb(var(--color-link));
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .pl-products .pl-products-title {
    margin: 18px 0 0;
    color: rgb(var(--color-foreground));
    font-family: var(--pl-font);
    font-size: 38px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .pl-products .pl-products-summary {
    margin: 0;
    color: rgba(var(--color-foreground), 0.7);
    font-size: 14px;
    line-height: 1.5;
  }


  .pl-products .pl-products-3 {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
  }


  .pl-products .pl-products-4 {
    position: relative;
    background: rgba(var(--color-foreground), 0.06);
    border: 1px solid rgba(var(--color-foreground), 0.15);
    overflow: hidden;
  }


  .pl-products .pl-products-image-link {
    display: block;
    width: 100%;
  }


  .pl-products .pl-products-image {
    position: relative;
    aspect-ratio: 3 / 4;
    width: 100%;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.06);
  }


  .pl-products .pl-products-image img,
  .pl-products .pl-products-image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .pl-products .pl-product-image-main {
    position: relative;
    z-index: 1;
    opacity: 1;
    transition:
      opacity 0.35s ease,
      transform 0.45s ease;
  }


  .pl-products .pl-product-image-hover {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    transition:
      opacity 0.35s ease,
      transform 0.45s ease;
  }


  @media (hover: hover) and (pointer: fine) {

    .pl-products .pl-products-4:hover .pl-products-image--has-hover .pl-product-image-hover {
      opacity: 1;
    }

    .pl-products .pl-products-4:hover .pl-products-image--has-hover .pl-product-image-main {
      opacity: 0;
    }

  }


  .pl-products .pl-products-placeholder {
    background: rgba(var(--color-foreground), 0.06);
  }


  .pl-products .pl-products-6 {
    font-family: var(--pl-font);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.25;
    margin: 20px 0 0;
    color: rgb(var(--color-foreground));
  }


  .pl-products .pl-products-6 a {
    color: inherit;
  }


  .pl-products .pl-products-6 a:hover {
    color: rgba(var(--color-link), 0.75);
  }


  .pl-products .pl-products-7 {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.7);
    margin-top: 7px;
  }


  .pl-products .pl-products-8 {
    font-size: 14px;
    line-height: 1.65;
    color: rgb(var(--color-foreground));
    margin-top: 12px;
  }


  .pl-products .pl-products-9 {
    margin-top: auto;
    padding-top: 20px;
  }


  .pl-products .pl-products-10 {
    display: block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.7);
    margin-bottom: 7px;
  }


  .pl-products .pl-products-11 {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;

    background-color: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: 2px;

    padding: 11px 32px 11px 14px;

    font-size: 14px;
    color: rgb(var(--color-foreground));

    cursor: pointer;

    background-image:
      linear-gradient(
        45deg,
        transparent 50%,
        rgba(var(--color-foreground), 0.7) 50%
      ),
      linear-gradient(
        135deg,
        rgba(var(--color-foreground), 0.7) 50%,
        transparent 50%
      );

    background-position:
      calc(100% - 18px) 50%,
      calc(100% - 14px) 50%;

    background-size: 4px 4px;
    background-repeat: no-repeat;
  }


  .pl-products .pl-products-12 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    margin-top: 14px;
    border-top: 1px solid rgba(var(--color-foreground), 0.15);
    padding-top: 14px;
  }


  .pl-products .pl-products-13 {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: rgba(var(--color-foreground), 0.7);
  }


  .pl-products .pl-products-14 {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-link));
  }


  .pl-products .pl-products-14:hover {
    color: rgba(var(--color-link), 0.75);
  }


  .pl-products .pl-products-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 50px 20px;
    color: rgba(var(--color-foreground), 0.7);
  }


  @media screen and (max-width: 989px) {

    .pl-products .pl-products-2 {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  @media screen and (max-width: 749px) {

    .pl-products .pl-products-heading { gap: 14px; }
    .pl-products .pl-products-title { font-size: 28px; margin-top: 12px; }
    .pl-products .pl-products-summary { font-size: 13px; }

    .pl-products .pl-products-1 {
      padding-top: var(--pl-padding-top-mobile);
      padding-bottom: var(--pl-padding-bottom-mobile);
    }

    .pl-products .pl-products-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 12px;
    }

    .pl-products .pl-products-6 {
      font-size: 16px;
      line-height: 1.3;
      margin-top: 12px;
      overflow-wrap: anywhere;
    }

    .pl-products .pl-products-8 {
      font-size: 13px;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }
    .pl-products .pl-products-7 {
      font-size: 10px;
      letter-spacing: 0.08em;
      overflow-wrap: anywhere;
    }
    .pl-products .pl-products-9 { padding-top: 16px; }
    .pl-products .pl-products-11 {
      min-height: 44px;
      font-size: 16px;
      padding-left: 10px;
    }
    .pl-products .pl-products-12 {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      margin-top: 12px;
      padding-top: 10px;
    }
    .pl-products .pl-products-13 { font-size: 11px; }
    .pl-products .pl-products-14 {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-size: 11px;
      letter-spacing: 0.04em;
      overflow-wrap: anywhere;
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "PL Product grid",
  "settings": [
    { "type": "header", "content": "Collection heading" },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Scenic Colorado Postcard Lanterns" },
    { "type": "text", "id": "availability_text", "label": "Availability text", "default": "Available in black and white" },
    { "type": "checkbox", "id": "show_count", "label": "Show collection product count", "default": true },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "designs" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },

    {
      "type": "header",
      "content": "Section spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top - desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom - desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },

    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top - mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },

    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom - mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "gate_label",
      "label": "Pricing note",
      "default": "Wholesale pricing"
    },

    {
      "type": "url",
      "id": "link_1",
      "label": "Login link"
    },

    {
      "type": "text",
      "id": "text_3",
      "label": "Login text",
      "default": "Log in for pricing"
    },

    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "assistant_n4"
    }
  ],

  "presets": [
    {
      "name": "PL Product grid"
    }
  ]
}
{% endschema %}

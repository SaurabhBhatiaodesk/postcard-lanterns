{% comment %}
PL Product Grid - Collection Based Version
Select collection from customizer and products will render automatically.
{% endcomment %}

<div id="PL-{{ section.id }}" class="pl-products">
<section class="pl-products-1">
<div class="pl-products-2">

{% assign collection = section.settings.collection %}

{% if collection != blank %}
{% for product in collection.products %}

<article class="pl-products-3">

<div class="pl-products-4">
{% if product.featured_image %}
{{ product.featured_image | image_url: width:900 | image_tag: loading:'lazy' }}
{% else %}
{{ 'product-1' | placeholder_svg_tag }}
{% endif %}
</div>

<h3 class="pl-products-6">{{ product.title }}</h3>

<p class="pl-products-8">
{{ product.description | strip_html | truncate:120 }}
</p>

<div class="pl-products-9">
<label class="pl-products-10">{{ section.settings.text_2 }}</label>
<select class="pl-products-11">
<option>{{ section.settings.white_label }}</option>
<option>{{ section.settings.black_label }}</option>
</select>

<div class="pl-products-12">
<span class="pl-products-13">{{ section.settings.gate_label }}</span>
<a href="{{ section.settings.link_1 }}" class="pl-products-14">{{ section.settings.text_3 }}</a>
</div>
</div>

</article>

{% endfor %}
{% endif %}

</div>
</section>
</div>

{% schema %}
{
  "name": "PL Product grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "text",
      "id": "gate_label",
      "label": "Pricing note",
      "default": "Wholesale pricing"
    },
    {
      "type": "text",
      "id": "white_label",
      "label": "White option",
      "default": "White"
    },
    {
      "type": "text",
      "id": "black_label",
      "label": "Black option",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "link_1",
      "label": "Login Link"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Frame colour",
      "default": "Frame colour"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Login Text",
      "default": "Log in for pricing"
    }
  ],
  "presets": [
    {
      "name": "PL Product grid"
    }
  ]
}
{% endschema %}

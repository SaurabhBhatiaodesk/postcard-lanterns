{% style %}
{{ section.settings.font | font_face: font_display: 'swap' }}
{% assign medium_font = section.settings.font | font_modify: 'weight', '500' %}{{ medium_font | font_face: font_display: 'swap' }}
#PL-{{ section.id }} { --pl-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }}; --pl-columns: {{ section.settings.columns }}; }
{% endstyle %}
<div id="PL-{{ section.id }}" class="pl-products">
<section class="pl-products-1">
    <div class="pl-products-2">
      {% for block in section.blocks %}{% assign lantern = block.settings.product %}<div class="pl-products-block" {{ block.shopify_attributes }}>
        <article class="pl-products-3">
          <div class="pl-products-4">
            {% assign card_image = block.settings.image | default: lantern.featured_image %}<div class="pl-products-image">{% if card_image != blank %}{{ card_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 550px) 50vw, 100vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'pl-products-placeholder' }}{% endif %}</div>
            {% if block.settings.white_only %}
              <div class="pl-products-5">{{ section.settings.text_1 | escape }}</div>
            {% endif %}
          </div>
          <h3 class="pl-products-6">{{ block.settings.title | default: lantern.title | escape }}</h3>
          <div class="pl-products-7">{{ block.settings.place | escape }}</div>
          <p class="pl-products-8">{{ block.settings.description | escape }}</p>
          <div class="pl-products-9">
            <label for="Frame-{{ section.id }}-{{ block.id }}" class="pl-products-10">{{ section.settings.text_2 | escape }}</label>
            <select id="Frame-{{ section.id }}-{{ block.id }}" name="frame" class="pl-products-11">
              <option value="White">{{ section.settings.white_label | escape }}</option>{% unless block.settings.white_only %}<option value="Black">{{ section.settings.black_label | escape }}</option>{% endunless %}
            </select>
            <div class="pl-products-12">
              <span class="pl-products-13">{{ section.settings.gate_label | escape }}</span>
              <a href="{{ section.settings.link_1 | escape }}" class="pl-products-14">{{ section.settings.text_3 | escape }}</a>
            </div>
          </div>
        </article>
      </div>{% endfor %}</div></section>
</div>

{% stylesheet %}
.pl-products {font-family:var(--pl-font);font-size:16px;font-weight:400;line-height:normal;letter-spacing:normal;color:#211d1a;background:#f7f3ea;-webkit-font-smoothing:antialiased} .pl-products *, .pl-products *::before, .pl-products *::after {box-sizing:border-box} .pl-products a {color:#a03f32;text-decoration:none} .pl-products a:hover {color:#7e2f25} .pl-products a:focus-visible, .pl-products select:focus-visible {outline:2px solid currentColor;outline-offset:4px} .pl-products select {font-family:inherit} .pl-products h1,.pl-products h2,.pl-products h3 {color:inherit} .pl-products [id] {scroll-margin-top:110px}
.pl-products .pl-products-1 { padding: 40px 40px 96px }
.pl-products .pl-products-2 { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: repeat(var(--pl-columns), minmax(0, 1fr)); gap: 40px 32px }
.pl-products .pl-products-3 { display: flex; flex-direction: column }
.pl-products .pl-products-4 { position: relative; background: #efe8da; border: 1px solid #e2d9c8; overflow: hidden }
.pl-products .pl-products-5 { position: absolute; top: 12px; left: 12px; background: rgba(247,243,234,0.94); color: #554e45; font-size: 10px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 6px 10px; border-radius: 2px }
.pl-products .pl-products-6 { font-family: var(--pl-font); font-weight: 500; font-size: 21px; line-height: 1.25; margin: 20px 0 0 }
.pl-products .pl-products-7 { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #6b6153; margin-top: 7px }
.pl-products .pl-products-8 { font-size: 14px; line-height: 1.65; color: #554e45; margin: 12px 0 0 }
.pl-products .pl-products-9 { margin-top: auto; padding-top: 20px }
.pl-products .pl-products-10 { display: block; font-size: 10px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: #655c4e; margin-bottom: 7px }
.pl-products .pl-products-11 { width: 100%; appearance: none; background: #fdfaf4; border: 1px solid #d9cdb8; border-radius: 2px; padding: 11px 14px; font-size: 14px; color: #211d1a }
.pl-products .pl-products-12 { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; border-top: 1px solid #e2d9c8; padding-top: 14px }
.pl-products .pl-products-13 { font-size: 12px; letter-spacing: 0.06em; color: #6b6153 }
.pl-products .pl-products-14 { font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #a03f32 }
.pl-products .pl-products-block,.pl-products article {height:100%;min-width:0} .pl-products .pl-products-image {aspect-ratio:3/4} .pl-products .pl-products-image img,.pl-products .pl-products-image svg {display:block;width:100%;height:100%;object-fit:cover} .pl-products select {cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,#655c4e 50%),linear-gradient(135deg,#655c4e 50%,transparent 50%);background-position:calc(100% - 18px) 50%,calc(100% - 14px) 50%;background-size:4px 4px;background-repeat:no-repeat;padding-right:32px} @media(max-width:989px){.pl-products .pl-products-2 {grid-template-columns:repeat(2,minmax(0,1fr))}} @media(max-width:549px){.pl-products .pl-products-2 {grid-template-columns:1fr}}
@media(max-width:749px){.pl-products > :first-child {padding-left:24px;padding-right:24px}}
{% endstylesheet %}


{% style %}
{{ section.settings.font | font_face: font_display: 'swap' }}
{% assign medium_font = section.settings.font | font_modify: 'weight', '500' %}{{ medium_font | font_face: font_display: 'swap' }}
#PL-{{ section.id }} { --pl-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }}; }
{% endstyle %}
<div id="PL-{{ section.id }}" class="pl-registration">
<section id="register" class="pl-registration-1">
    <div class="pl-registration-2">
      <div class="pl-registration-3">{{ section.settings.text_1 | escape }}</div>
      <h2 class="pl-registration-4">{{ section.settings.text_2 | escape }}</h2>
      <p class="pl-registration-5">{{ section.settings.text_3 | escape }}</p>
      <div class="pl-registration-6">
        <a href="{{ section.settings.link_1 | escape }}" class="pl-registration-7">{{ section.settings.text_4 | escape }}</a>
        <a href="{{ section.settings.link_2 | escape }}" class="pl-registration-8">{{ section.settings.text_5 | escape }}</a>
      </div>
      <div class="pl-registration-9">
        <span>{{ section.settings.text_6 | escape }}</span>
        <span class="pl-registration-10">{{ section.settings.text_7 | escape }}</span>
        <span>{{ section.settings.text_8 | escape }}</span>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.pl-registration {font-family:var(--pl-font);font-size:16px;font-weight:400;line-height:normal;letter-spacing:normal;color:#211d1a;background:#f7f3ea;-webkit-font-smoothing:antialiased} .pl-registration *, .pl-registration *::before, .pl-registration *::after {box-sizing:border-box} .pl-registration a {color:#a03f32;text-decoration:none} .pl-registration a:hover {color:#7e2f25} .pl-registration a:focus-visible, .pl-registration select:focus-visible {outline:2px solid currentColor;outline-offset:4px} .pl-registration select {font-family:inherit} .pl-registration h1,.pl-registration h2,.pl-registration h3 {color:inherit} .pl-registration [id] {scroll-margin-top:110px}
.pl-registration .pl-registration-1 { padding: 88px 40px }
.pl-registration .pl-registration-2 { max-width: 820px; margin: 0 auto; text-align: center }
.pl-registration .pl-registration-3 { font-size: 11px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #a03f32 }
.pl-registration .pl-registration-4 { font-family: var(--pl-font); font-weight: 500; font-size: clamp(30px, 4vw, 40px); line-height: 1.15; letter-spacing: -0.01em; margin: 16px 0 0 }
.pl-registration .pl-registration-5 { font-size: 16px; line-height: 1.7; color: #554e45; margin: 18px auto 0; max-width: 54ch }
.pl-registration .pl-registration-6 { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 34px }
.pl-registration .pl-registration-7 { display: inline-block; background: #a03f32; color: #fdfaf4; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 16px 32px; border-radius: 2px }
.pl-registration .pl-registration-7:hover { background: #7e2f25; color: #fdfaf4 }
.pl-registration .pl-registration-8 { display: inline-block; border: 1px solid #c8bca6; color: #211d1a; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 16px 32px; border-radius: 2px }
.pl-registration .pl-registration-8:hover { border-color: #211d1a; color: #211d1a }
.pl-registration .pl-registration-9 { display: flex; flex-wrap: wrap; gap: 10px 28px; justify-content: center; margin-top: 40px; border-top: 1px solid #e2d9c8; padding-top: 24px; font-size: 13px; color: #554e45 }
.pl-registration .pl-registration-10 { color: #c8bca6 }

@media(max-width:749px){.pl-registration > :first-child {padding-left:24px;padding-right:24px}}
{% endstylesheet %}


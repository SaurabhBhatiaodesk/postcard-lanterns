{% style %}
{{ section.settings.font | font_face: font_display: 'swap' }}
{% assign medium_font = section.settings.font | font_modify: 'weight', '500' %}{{ medium_font | font_face: font_display: 'swap' }}
#PL-{{ section.id }} { --pl-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }}; }
{% endstyle %}
{% capture navigation_links %}
  <a href="{{ section.settings.link_1 | escape }}" class="pl-header-6">{{ section.settings.text_3 | escape }}</a>
  <a href="{{ section.settings.link_2 | escape }}" class="pl-header-7">{{ section.settings.text_4 | escape }}</a>
  <a href="{{ section.settings.link_3 | escape }}" class="pl-header-8">{{ section.settings.text_5 | escape }}</a>
  <a href="{{ section.settings.link_4 | escape }}" class="pl-header-9">{{ section.settings.text_6 | escape }}</a>
{% endcapture %}
<pl-mobile-header id="PL-{{ section.id }}" class="pl-header">
<header class="pl-header-1 page-width">
    <div class="pl-header-2">
      <span class="pl-header-3">{{ section.settings.text_1 | escape }}</span>
      <span class="pl-header-4">{{ section.settings.text_2 | escape }}</span>
    </div>
    <nav class="pl-header-5" aria-label="{{ section.settings.menu_label | escape }}">{{ navigation_links }}</nav>
    <button class="pl-header-toggle" type="button" aria-label="{{ section.settings.menu_label | escape }}" aria-expanded="false" aria-controls="PL-Menu-{{ section.id }}" aria-haspopup="dialog">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <dialog id="PL-Menu-{{ section.id }}" class="pl-header-drawer" aria-label="{{ section.settings.menu_label | escape }}">
      <div class="pl-header-drawer-top">
        <span class="pl-header-3">{{ section.settings.text_1 | escape }}</span>
        <button class="pl-header-close" type="button" aria-label="{{ section.settings.close_label | escape }}" autofocus>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <nav class="pl-header-drawer-links" aria-label="{{ section.settings.menu_label | escape }}">{{ navigation_links }}</nav>
    </dialog>
  </header>
</pl-mobile-header>

{% stylesheet %}
.pl-header {font-family:var(--pl-font);font-size:16px;font-weight:400;line-height:normal;letter-spacing:normal;color:#211d1a;background:#f7f3ea;-webkit-font-smoothing:antialiased} .pl-header *, .pl-header *::before, .pl-header *::after {box-sizing:border-box} .pl-header a {color:#a03f32;text-decoration:none} .pl-header a:hover {color:#7e2f25} .pl-header a:focus-visible, .pl-header select:focus-visible {outline:2px solid currentColor;outline-offset:4px} .pl-header select {font-family:inherit} .pl-header h1,.pl-header h2,.pl-header h3 {color:inherit} .pl-header [id] {scroll-margin-top:110px}
.pl-header .pl-header-1 { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-top: 18px; padding-bottom: 18px; border-bottom: 1px solid #e2d9c8; background: #f7f3ea; position: sticky; top: 0; z-index: 20 }
.pl-header .pl-header-2 { display: flex; align-items: baseline; gap: 10px }
.pl-header .pl-header-3 { font-family: var(--pl-font); font-weight: 600; font-size: 20px; letter-spacing: 0.02em }
.pl-header .pl-header-4 { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #655c4e; border-left: 1px solid #d9cdb8; padding-left: 10px }
.pl-header .pl-header-5 { display: flex; align-items: center; gap: 22px }
.pl-header .pl-header-6 { font-size: 13px; letter-spacing: 0.04em; color: #4a443c }
.pl-header .pl-header-7 { font-size: 13px; letter-spacing: 0.04em; color: #4a443c }
.pl-header .pl-header-8 { font-size: 13px; letter-spacing: 0.04em; color: #4a443c }
.pl-header .pl-header-9 { display: inline-block; background: #a03f32; color: #fdfaf4; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; padding: 11px 20px; border-radius: 2px }
.pl-header .pl-header-9:hover { background: #7e2f25; color: #fdfaf4 }
.shopify-section:has(> .pl-header) {position:sticky;top:0;z-index:20} .pl-header .pl-header-5 {flex-wrap:wrap} @media(max-width:749px){.pl-header .pl-header-1 {gap:16px} .pl-header .pl-header-5 {gap:14px}}

.pl-header {display:block}
.pl-header .pl-header-toggle,.pl-header .pl-header-close {align-items:center;justify-content:center;width:44px;height:44px;flex-shrink:0;padding:10px;border:0;background:transparent;color:#211d1a;cursor:pointer}
.pl-header .pl-header-toggle {display:none}
.pl-header .pl-header-close {display:flex}
.pl-header button:focus-visible {outline:2px solid #a03f32;outline-offset:3px}
.pl-header .pl-header-drawer {position:fixed;inset:0 0 0 auto;width:min(360px,90vw);height:100%;height:100dvh;max-width:none;max-height:none;margin:0;padding:24px;border:0;background:#f7f3ea;color:#211d1a;font-family:var(--pl-font);overflow-y:auto;overscroll-behavior:contain;box-shadow:-12px 0 40px #0002}
.pl-header .pl-header-drawer[open] {animation:pl-menu-enter 220ms ease-out}
.pl-header .pl-header-drawer::backdrop {background:rgb(33 29 26 / 48%)}
.pl-header .pl-header-drawer-top {display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:24px;border-bottom:1px solid #e2d9c8}
.pl-header .pl-header-drawer-links {display:flex;flex-direction:column;align-items:stretch;gap:0;padding-top:20px}
.pl-header .pl-header-drawer-links a {padding:16px 0;font-size:16px}
.pl-header .pl-header-drawer-links .pl-header-9 {margin-top:24px;padding:16px 20px;font-size:12px;text-align:center}
html:has(.pl-header-drawer[open]),body:has(.pl-header-drawer[open]) {overflow:hidden}
@keyframes pl-menu-enter {from {transform:translateX(100%)} to {transform:translateX(0)}}
@media(max-width:749px){
  .pl-header .pl-header-1 {flex-wrap:nowrap;gap:12px;padding-top:14px;padding-bottom:14px}
  .pl-header .pl-header-2 {flex-wrap:wrap;gap:4px 10px;min-width:0}
  .pl-header:defined .pl-header-5 {display:none}
  .pl-header:defined .pl-header-toggle {display:flex}
  .pl-header:not(:defined) .pl-header-1 {flex-wrap:wrap}
  .pl-header .pl-header-3 {font-size:20px}
  .pl-header .pl-header-4 {font-size:9px}
}
@media(prefers-reduced-motion:reduce){.pl-header .pl-header-drawer[open] {animation:none}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('pl-mobile-header')) {
  customElements.define('pl-mobile-header', class extends HTMLElement {
    connectedCallback() {
      this.events = new AbortController();
      const options = { signal: this.events.signal };
      const dialog = this.querySelector('dialog');
      const toggle = this.querySelector('.pl-header-toggle');
      const desktop = window.matchMedia('(min-width: 750px)');
      const close = () => dialog.close();
      toggle.addEventListener('click', () => {
        dialog.showModal();
        toggle.setAttribute('aria-expanded', 'true');
      }, options);
      this.querySelector('.pl-header-close').addEventListener('click', close, options);
      dialog.addEventListener('click', (event) => {
        if (event.target.closest('a')) close();
        if (event.target === dialog) {
          const bounds = dialog.getBoundingClientRect();
          if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) close();
        }
      }, options);
      dialog.addEventListener('close', () => {
        toggle.setAttribute('aria-expanded', 'false');
      }, options);
      desktop.addEventListener('change', () => {
        if (desktop.matches && dialog.open) close();
      }, options);
    }
    disconnectedCallback() {
      this.querySelector('dialog')?.close();
      this.events?.abort();
    }
  });
}
{% endjavascript %}

